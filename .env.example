# Copy to .env.local. Restart pnpm dev after changing the backend.
# Rebuild production after changing NEXT_PUBLIC_DECISION_BACKEND.
NEXT_PUBLIC_DECISION_BACKEND=preview
# Set the backend above to jev to enable live decisions.
# Server only. Never prefix this key with NEXT_PUBLIC_.
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-1.13.0
# Optional development-only session files. Set to 1 to record live Jev runs.
NEXT_PUBLIC_JEV_SESSION_AUDIT=0
# Production live mode requires a shared Redis budget; missing storage fails closed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
JEV_DAILY_REQUEST_LIMIT=20000
# Optional initial render detail for machines without a GPU. Default is Auto.
# NEXT_PUBLIC_RENDER_QUALITY=low
